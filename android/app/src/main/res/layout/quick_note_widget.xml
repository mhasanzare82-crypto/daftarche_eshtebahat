<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/quick_note_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/notebook_widget_background"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="4dp"
    android:layoutDirection="locale">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="✎  یادداشت اشتباهات"
        android:textColor="#F5F6F8"
        android:textSize="8sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:text="برای ثبت و ذخیره اشتباه جدید لمس کن"
        android:textColor="#C4CCD6"
        android:textSize="7sp" />

    <TextView
        android:id="@+id/quick_note_open"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:background="#39434F"
        android:paddingStart="5dp"
        android:paddingTop="3dp"
        android:paddingEnd="5dp"
        android:paddingBottom="3dp"
        android:text="ثبت اشتباه جدید"
        android:textColor="#FFFFFF"
        android:textSize="8sp"
        android:textStyle="bold" />
</LinearLayout>