<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:id="@+id/daily_widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
 android:padding="14dp" android:background="#202329">
 <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical">
  <TextView android:id="@+id/daily_widget_title" android:layout_width="match_parent" android:layout_height="wrap_content"
   android:text="یادآوری‌های روزانه" android:textSize="13sp" android:textStyle="bold" android:textColor="#F4F4F5" android:maxLines="2"/>
  <TextView android:id="@+id/daily_widget_body" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
   android:gravity="center_vertical" android:text="متن یادآوری" android:textSize="16sp" android:textColor="#F4F4F5" android:maxLines="7" android:ellipsize="end"/>
  <TextView android:id="@+id/daily_widget_next" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="end"
   android:paddingTop="5dp" android:paddingBottom="4dp" android:text="بعدی  ›" android:textSize="12sp" android:textColor="#F4F4F5" android:clickable="true"/>
 </LinearLayout>
</FrameLayout>