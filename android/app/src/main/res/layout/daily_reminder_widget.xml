<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/daily_reminder_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#242A32"
    android:clickable="true"
    android:focusable="true"
    android:layoutDirection="locale">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/daily_reminder_heading"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="یادآوری‌های روزانه"
            android:textColor="#BFC7D2"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/daily_reminder_next"
            android:layout_width="40dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:background="#39434F"
            android:text="↻"
            android:textColor="#BFC7D2"
            android:textSize="21sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/daily_reminder_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="13dp"
        android:maxLines="2"
        android:ellipsize="end"
        android:textColor="#C4CCD6"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/daily_reminder_body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="7dp"
        android:gravity="top"
        android:maxLines="5"
        android:ellipsize="end"
        android:textColor="#C4CCD6"
        android:textSize="13sp" />
</LinearLayout>
