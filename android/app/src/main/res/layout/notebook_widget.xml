<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/notebook_widget_background"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="14dp"
    android:layoutDirection="locale">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="دفترچه اشتباهات"
            android:textColor="#F2F4F7"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_note_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="یادداشت‌ها: ۰"
            android:textColor="#B9C1CC"
            android:textSize="10sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_folder_count"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="پوشه‌ها: ۰"
        android:textColor="#929BA8"
        android:textSize="10sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="9dp"
        android:layout_marginBottom="7dp"
        android:background="#46505D" />

    <LinearLayout
        android:id="@+id/widget_note_1_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingVertical="3dp">
        <TextView
            android:id="@+id/widget_note_1_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="آخرین یادداشت"
            android:textColor="#F2F4F7"
            android:textSize="12sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/widget_note_1_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="خلاصه یادداشت"
            android:textColor="#C1C8D1"
            android:textSize="10sp" />
        <TextView
            android:id="@+id/widget_note_1_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#8793A1"
            android:textSize="9sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="4dp"
        android:background="#3B444F" />

    <LinearLayout
        android:id="@+id/widget_note_2_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingVertical="3dp">
        <TextView
            android:id="@+id/widget_note_2_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#F2F4F7"
            android:textSize="12sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/widget_note_2_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#C1C8D1"
            android:textSize="10sp" />
        <TextView
            android:id="@+id/widget_note_2_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#8793A1"
            android:textSize="9sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="4dp"
        android:background="#3B444F" />

    <LinearLayout
        android:id="@+id/widget_note_3_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingVertical="3dp">
        <TextView
            android:id="@+id/widget_note_3_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#F2F4F7"
            android:textSize="12sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/widget_note_3_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#C1C8D1"
            android:textSize="10sp" />
        <TextView
            android:id="@+id/widget_note_3_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#8793A1"
            android:textSize="9sp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="bottom|end"
        android:text="برای باز کردن دفترچه لمس کن  ←"
        android:textColor="#AEB8C5"
        android:textSize="10sp" />
</LinearLayout>
